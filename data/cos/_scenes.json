  "face_risk_prompts": {
    "hat_shadow": "帽檐下自然入画的面部保留可辨轮廓，允许柔和帽檐阴影，不为露脸掀帽或改变头饰位置。",
    "hair_shadow": "自然入画的面部与发丝有适度明暗分离，保留发丝本身的局部遮挡和投影，不强行拨开发型。",
    "reflective_costume": "金属、缎面与透明衣料按各自材质响应同一主光，高光随曲面变化，不出现独立发光或大片剪白。",
    "glass_reflection": "玻璃只保留符合场景光源的环境反射，不复制人物轮廓或制造重影。",
    "scattered_light": "散射效果保持克制，人物轮廓与服装保留正常局部反差，不覆盖均匀白雾。",
    "low_light": "保留夜间环境本身的暗部，仅让入画的受光轮廓与衣料层次自然可辨，不把夜景整体提亮成白天。",
    "mixed_light": "冷暖环境光保持明确主次，人物肤色与衣料颜色自然过渡，不出现突兀色块。",
    "visual_noise": "背景线条与亮点避开人物关键轮廓，不形成杂乱高光或穿过身体的硬边。",
    "backlight": "逆光边缘与背光暗部自然衔接，保留人物和衣料的体积层次，不做均匀发光描边。",
    "high_contrast": "强反差环境中保留受光面的中间调与衣料层次，不把高光剪白或暗部涂黑。",
    "projection_light": "投影纹理服从已有场景，仅保留合理的环境影响，不把文字或图案叠到人物五官上。",
    "reflective_background": "湿地、玻璃或金属背景只产生符合空间关系的环境反射，不复制人物或制造额外肢体。"
  },
